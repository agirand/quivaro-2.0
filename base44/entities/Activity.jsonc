{
  "name": "Activity",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "completed",
        "assigned",
        "approval",
        "info",
        "rejected"
      ]
    }
  },
  "required": [
    "agent",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}