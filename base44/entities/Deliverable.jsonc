{
  "name": "Deliverable",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "accepted",
        "revision_requested"
      ],
      "default": "ready"
    },
    "accepted_at": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean"
    }
  },
  "required": [
    "org_id",
    "work_order_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}