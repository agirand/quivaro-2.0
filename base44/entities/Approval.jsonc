{
  "name": "Approval",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "doc_reminder",
        "invoice_reminder",
        "new_matter",
        "strategy",
        "client_email",
        "exception"
      ]
    },
    "title": {
      "type": "string"
    },
    "client_code": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "matter_id": {
      "type": "string"
    },
    "matter_title": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decided_at": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}