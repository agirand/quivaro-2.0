{
  "name": "DocumentRequest",
  "type": "object",
  "properties": {
    "client_code": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "matter_title": {
      "type": "string"
    },
    "document": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "outstanding",
        "received"
      ]
    },
    "language": {
      "type": "string"
    },
    "last_reminder": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "document"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}