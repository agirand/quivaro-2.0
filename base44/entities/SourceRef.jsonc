{
  "name": "SourceRef",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "email",
        "document",
        "financial",
        "conversation"
      ]
    },
    "provider": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "is_sample": {
      "type": "boolean"
    }
  },
  "required": [
    "org_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}